VITE_STATUS_API_URL=/api/mcstatus
VITE_LAUNCHER_DOWNLOAD_URL=
VITE_CLIENT_VERSION=1.4.0
VITE_SERVER_ADDRESS=play.nexusgit.info
VITE_VOICE_ADDRESS=voice.nexusgit.info
VITE_USE_MOCK_STATUS=false
# Backend server origin/base WITHOUT /api. Unset disables account operations.
# HTTPS is required except for loopback development (http://localhost/127.0.0.1/[::1]).
# Example local configuration: http://localhost:8000
VITE_API_BASE_URL=https://api.nexusgit.info
# Valid HTTPS github.com/sponsors/<recipient> URL only; recipient unresolved.
VITE_SPONSORS_URL=
# Optional Vite base path for hosting below a subdirectory.
BASE_PATH=/
